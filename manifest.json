{
  "manifest_version": 3,
  "name": "PokeArgentum Extension",
  "description": "Herramientas de PokeArgentum: qué tenés en las tiendas donde comprás, envíos, facturación y MercadoLibre.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "pokeargentum.html",
    "default_title": "PokeArgentum",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Mostrar u ocultar el panel de la carta en una tienda"
    }
  },
  "permissions": ["storage", "unlimitedStorage", "tabs", "activeTab", "scripting", "webRequest", "downloads"],
  "host_permissions": ["https://www.pokellector.com/*", "https://fe.afip.gob.ar/*", "https://www.correoargentino.com.ar/*", "https://cartas.konekotekka.com.ar/*", "http://localhost:3000/*"],
  "background": {
    "service_worker": "scripts/lib/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://articulo.mercadolibre.com.ar/*", "https://www.mercadolibre.com.ar/*"],
      "js": ["scripts/controllers/ml-admin-link.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.bringitimport.com/*"],
      "js": ["scripts/controllers/bringit-page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.bringitimport.com/*"],
      "js": ["scripts/controllers/bringit.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.correoargentino.com.ar/formularios/e-commerce*"],
      "js": ["scripts/controllers/correo-seguimiento.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://fe.afip.gob.ar/*"],
      "js": ["scripts/all.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://auth.afip.gob.ar/*"],
      "js": ["scripts/arca-session.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:3000/*", "https://tcg-premium.vercel.app/*", "https://www.mercadolibre.com.ar/ventas/*", "https://pokeargentum.com/*", "https://www.pokeargentum.com/*", "https://konekotekka.com/*", "https://www.konekotekka.com/*", "https://cartas.konekotekka.com.ar/*"],
      "js": ["scripts/lib/storage.js", "scripts/controllers/tcg-premium.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://vendedores.mercadolibre.com.ar/emisor/*", "https://www.mercadolibre.com.ar/emisor/*", "https://vendedores.mercadolibre.com.ar/ventas/*/detalle*", "https://www.mercadolibre.com.ar/ventas/*/detalle*"],
      "js": ["scripts/controllers/ml-invoices.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.correoargentino.com.ar/MiCorreo/public/envioCla"],
      "js": ["scripts/correoArgentino.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.mercadolibre.com.ar/ventas/*"],
      "js": ["scripts/controllers/sales.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.mercadopago.com.ar/tools/home-one-shot"],
      "js": ["scripts/controllers/mp.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://pymes.andreani.com/*"],
      "js": ["scripts/andreani.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.mercadopago.com.ar/link-tools/congrats/*"],
      "js": ["scripts/controllers/mercadopago.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://poke-collect.com/*", "https://www.poke-collect.com/*", "https://www.coolstuffinc.com/*", "https://wulfgaming.com/*", "https://www.wulfgaming.com/*", "https://store.gglehi.com/*", "https://playerscandc.com/*", "https://www.playerscandc.com/*", "https://omotenashitcg.com/*", "https://www.omotenashitcg.com/*", "https://magicandmonsters.com/*", "https://www.magicandmonsters.com/*", "https://smokeandmirrorshobby.com/*", "https://www.smokeandmirrorshobby.com/*", "https://www.tcgplayer.com/*"],
      "js": ["scripts/lib/shop-core.js", "scripts/controllers/shop-marks.js"],
      "css": ["scripts/controllers/shop-marks.css"],
      "run_at": "document_idle"
    }
  ]
}