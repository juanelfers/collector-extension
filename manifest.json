{
  "manifest_version": 3,
  "name": "PokeArgentum Extension",
  "description": "Extensión para PokeArgentum",
  "version": "0.0.1",
  "action": {
    "default_popup": "pokeargentum.html",
    "default_icon": "src/img/lapras.webp"
  },
  "permissions": ["storage", "tabs", "activeTab", "scripting", "webRequest", "downloads"],
  "host_permissions": ["https://www.pokellector.com/*"],
  "background": {
    "service_worker": "scripts/lib/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://fe.afip.gob.ar/*"],
      "js": ["scripts/all.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:3000/*", "https://tcg-premium.vercel.app/*", "https://www.mercadolibre.com.ar/ventas/*", "https://www.pokeargentum.com/*"],
      "js": ["scripts/lib/storage.js", "scripts/controllers/tcg-premium.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.correoargentino.com.ar/MiCorreo/public/envioCla"],
      "js": ["scripts/correoArgentino.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.mercadolibre.com.ar/ventas/*"],
      "js": ["scripts/controllers/sales.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.mercadopago.com.ar/tools/home-one-shot"],
      "js": ["scripts/controllers/mp.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://pymes.andreani.com/hacer-envio/*"],
      "js": ["scripts/andreani.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.mercadopago.com.ar/link-tools/congrats/*"],
      "js": ["scripts/controllers/mercadopago.js"],
      "run_at": "document_end"
    }
  ]
}